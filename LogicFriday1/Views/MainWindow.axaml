<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LogicFriday1.Controls"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dockFactory="using:Dock.Model.Avalonia"
        xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
        xmlns:icons="using:LogicFriday1.MaterialIcons"
        xmlns:models="using:LogicFriday1.Models"
        xmlns:vm="using:LogicFriday1.ViewModels"
        xmlns:views="using:LogicFriday1.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="LogicFriday1.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LogicFriday1"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        KeyDown="MainWindow_OnKeyDown">

    <Window.Styles>
        <Style Selector="Button.toolbarButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbarButton icons|PackIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSurface}" />
        </Style>
        <Style Selector="Button.toolbarButton:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="Button.toolbarButton:disabled icons|PackIcon">
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSurfaceVariant}" />
        </Style>
        <Style Selector="Button.toolbarButton:disabled:pointerover icons|PackIcon">
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSurfaceVariant}" />
        </Style>
        <Style Selector="Button.toolbarButton:pointerover icons|PackIcon">
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSecondaryContainer}" />
        </Style>
        <Style Selector="Button.gatePaletteButton">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="60" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.gatePaletteButton icons|PackIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSurface}" />
        </Style>
        <Style Selector="Button.gatePaletteButton:pointerover icons|PackIcon">
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSecondaryContainer}" />
        </Style>
        <Style Selector="Button.gatePaletteButton.active">
            <Setter Property="Background" Value="{DynamicResource LogicFriday.Brush.SecondaryContainer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LogicFriday.Brush.Primary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gatePaletteButton.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LogicFriday.Brush.OnSecondaryContainer}" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type models:GatePaletteItem}" x:DataType="models:GatePaletteItem">
            <Grid RowDefinitions="*,Auto">
                <controls:GatePaletteGlyph Grid.Row="0"
                                           Item="{Binding}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="10"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource LogicFriday.Brush.OnSurfaceVariant}" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"
                          IsEnabled="{Binding IsFileNewEnabled}">
                    <MenuItem Header="Truth _Table"
                              IsEnabled="{Binding IsFileNewEnabled}"
                              Click="NewTruthTable_OnClick" />
                    <MenuItem Header="Logic _Equation"
                              IsEnabled="{Binding IsFileNewEnabled}"
                              Click="NewLogicEquation_OnClick" />
                    <MenuItem Header="Gate _Diagram"
                              IsEnabled="{Binding IsFileNewEnabled}"
                              Click="NewGateDiagram_OnClick" />
                </MenuItem>
                <MenuItem Header="_Open..."
                          IsEnabled="{Binding IsFileOpenEnabled}"
                          Click="OpenDocument_OnClick" />
                <MenuItem Header="_Close"
                          Click="CloseDocument_OnClick" />
                <Separator />
                <MenuItem Header="Save _As..."
                          IsEnabled="{Binding IsFileSaveAsEnabled}"
                          Click="SaveAs_OnClick" />
                <Separator />
                <MenuItem Header="_Import Truth Table..."
                          Click="ImportTruthTable_OnClick" />
                <MenuItem Header="Export _Truth Table..."
                          IsEnabled="{Binding IsFileExportTruthTableEnabled}"
                          Click="ExportTruthTable_OnClick" />
                <MenuItem Header="Export _Gate Diagram..."
                          IsEnabled="{Binding IsFileExportGateDiagramEnabled}"
                          Click="ExportGateDiagram_OnClick" />
                <Separator />
                <MenuItem Header="_Print..."
                          IsEnabled="{Binding IsFilePrintEnabled}"
                          Click="Print_OnClick" />
                <Separator />
                <MenuItem Header="E_xit"
                          Click="Exit_OnClick" />
            </MenuItem>

            <MenuItem Header="_Operation">
                <MenuItem Header="_Minimize..."
                          IsEnabled="{Binding IsOperationMinimizeEnabled}"
                          Click="Minimize_OnClick" />
                <MenuItem Header="Map to _Gates..."
                          IsEnabled="{Binding IsOperationMapToGatesEnabled}"
                          Click="MapToGates_OnClick" />
                <MenuItem Header="Generate _Lookup Function"
                          IsEnabled="{Binding IsOperationGenerateLookupFunctionEnabled}">
                    <MenuItem Header="(V)_HDL"
                              Tag="Vhdl"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_Verilog"
                              Tag="Verilog"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_C"
                              Tag="C"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_Rust"
                              Tag="Rust"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="C_#"
                              Tag="CSharp"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_Java"
                              Tag="Java"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_Python"
                              Tag="Python"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="Java_Script"
                              Tag="JavaScript"
                              Click="GenerateLookupFunction_OnClick" />
                    <MenuItem Header="_Go"
                              Tag="Go"
                              Click="GenerateLookupFunction_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Clo_ne Function"
                          IsEnabled="{Binding IsOperationCloneFunctionEnabled}"
                          Click="CloneFunction_OnClick" />
                <Separator />
                <MenuItem Header="Compa_re Functions"
                          IsEnabled="{Binding IsOperationCompareFunctionsEnabled}"
                          Click="CompareFunctions_OnClick" />
                <MenuItem Header="_OR Functions"
                          IsEnabled="{Binding IsOperationOrFunctionsEnabled}"
                          Click="OrFunctions_OnClick" />
                <MenuItem Header="_AND Functions"
                          IsEnabled="{Binding IsOperationAndFunctionsEnabled}"
                          Click="AndFunctions_OnClick" />
                <MenuItem Header="_XOR Functions"
                          IsEnabled="{Binding IsOperationXorFunctionsEnabled}"
                          Click="XorFunctions_OnClick" />
                <Separator />
                <MenuItem Header="_Cancel Esc"
                          IsEnabled="{Binding IsOperationCancelEnabled}"
                          Click="OperationCancel_OnClick" />
            </MenuItem>

            <MenuItem Header="T_ruthtable">
                <MenuItem Header="_Modify Truth Table"
                          IsEnabled="{Binding IsTruthTableModifyEnabled}"
                          Click="ModifyTruthTable_OnClick" />
                <Separator />
                <MenuItem Header="Show Tr_ue and Don't Care"
                          ToggleType="Radio"
                          GroupName="TruthTableShowMode"
                          IsChecked="{Binding IsShowTrueAndDontCareTruthTableRowsSelected, Mode=OneWay}"
                          IsEnabled="{Binding IsTruthTableShowModeEnabled}"
                          Click="ShowTrueAndDontCareTruthTableRows_OnClick" />
                <MenuItem Header="Show All _Rows"
                          ToggleType="Radio"
                          GroupName="TruthTableShowMode"
                          IsChecked="{Binding IsShowAllTruthTableRowsSelected, Mode=OneWay}"
                          IsEnabled="{Binding IsTruthTableShowModeEnabled}"
                          Click="ShowAllTruthTableRows_OnClick" />
                <Separator />
                <MenuItem x:Name="TruthTableSelectAllMainMenuItem"
                          Header="Select _All"
                          IsEnabled="False"
                          Click="TruthTableSelectAll_OnClick" />
                <Separator />
                <MenuItem x:Name="TruthTableSetTrueMainMenuItem"
                          Header="_True"
                          IsEnabled="False"
                          Click="TruthTableSetTrue_OnClick" />
                <MenuItem x:Name="TruthTableSetFalseMainMenuItem"
                          Header="_False"
                          IsEnabled="False"
                          Click="TruthTableSetFalse_OnClick" />
                <MenuItem x:Name="TruthTableSetDontCareMainMenuItem"
                          Header="_Don't Care"
                          IsEnabled="False"
                          Click="TruthTableSetDontCare_OnClick" />
                <MenuItem x:Name="TruthTableInvertMainMenuItem"
                          Header="_Invert"
                          IsEnabled="False"
                          Click="TruthTableInvert_OnClick" />
                <Separator />
                <MenuItem Header="_Submit (Enter)"
                          IsEnabled="{Binding IsTruthTableSubmitEnabled}"
                          Click="TruthTableSubmit_OnClick" />
                <MenuItem Header="_Cancel (Esc)"
                          IsEnabled="{Binding IsTruthTableCancelEnabled}"
                          Click="TruthTableCancel_OnClick" />
            </MenuItem>

            <MenuItem Header="_Equation">
                <MenuItem Header="_Modify Equation"
                          IsEnabled="{Binding IsEquationModifyEnabled}"
                          Click="ModifyLogicEquation_OnClick" />
                <Separator />
                <MenuItem Header="Sum of Produc_ts"
                          IsEnabled="{Binding IsEquationFormatEnabled}"
                          Click="EquationSumOfProducts_OnClick" />
                <MenuItem Header="Pro_duct of Sums"
                          IsEnabled="{Binding IsEquationFormatEnabled}"
                          Click="EquationProductOfSums_OnClick" />
                <MenuItem Header="_Factor"
                          IsEnabled="{Binding IsEquationFormatEnabled}"
                          Click="EquationFactor_OnClick" />
                <Separator />
                <MenuItem x:Name="EquationUndoMainMenuItem"
                          Header="_Undo (Ctrl+Z)"
                          IsEnabled="False"
                          Click="EquationEditorUndo_OnClick" />
                <MenuItem x:Name="EquationRedoMainMenuItem"
                          Header="_Redo (Ctrl+Y)"
                          IsEnabled="False"
                          Click="EquationEditorRedo_OnClick" />
                <Separator />
                <MenuItem x:Name="EquationCutMainMenuItem"
                          Header="Cu_t (Ctrl+X)"
                          IsEnabled="False"
                          Click="EquationEditorCut_OnClick" />
                <MenuItem x:Name="EquationCopyMainMenuItem"
                          Header="_Copy (Ctrl+C)"
                          IsEnabled="False"
                          Click="EquationEditorCopy_OnClick" />
                <MenuItem x:Name="EquationPasteMainMenuItem"
                          Header="_Paste (Ctrl+V)"
                          IsEnabled="False"
                          Click="EquationEditorPaste_OnClick" />
                <MenuItem x:Name="EquationDeleteMainMenuItem"
                          Header="_Delete (Del)"
                          IsEnabled="False"
                          Click="EquationEditorDelete_OnClick" />
                <MenuItem x:Name="EquationSelectAllMainMenuItem"
                          Header="Select _All (Ctrl+A)"
                          IsEnabled="False"
                          Click="EquationEditorSelectAll_OnClick" />
                <Separator />
                <MenuItem Header="_Submit (Enter)"
                          IsEnabled="{Binding IsEquationSubmitEnabled}"
                          Click="EquationEditorSubmit_OnClick" />
                <MenuItem Header="_Cancel (Esc)"
                          IsEnabled="{Binding IsEquationCancelEnabled}"
                          Click="EquationEditorCancel_OnClick" />
            </MenuItem>

            <MenuItem Header="_Gates">
                <MenuItem Header="_Modify Gate Diagram"
                          IsEnabled="{Binding IsGatesModifyGateDiagramEnabled}"
                          Click="ModifyGateDiagram_OnClick" />
                <Separator />
                <MenuItem Header="_Copy to Clipboard"
                          IsEnabled="{Binding IsGatesCopyToClipboardEnabled}"
                          Click="GateCopyToClipboard_OnClick" />
                <MenuItem Header="IC _Package Info..."
                          IsEnabled="{Binding IsGatesIcPackageInfoEnabled}"
                          Click="GateIcPackageInfo_OnClick" />
                <MenuItem Header="_Trace Gate Logic"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsGatesTraceLogicChecked, Mode=OneWay}"
                          IsEnabled="{Binding IsGatesTraceLogicEnabled}"
                          Click="GateTraceLogic_OnClick" />
                <Separator />
                <MenuItem Header="_Auto Redraw Diagram"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateAutoRedraw_OnClick" />
                <Separator />
                <MenuItem Header="Zoom _In"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateZoomIn_OnClick" />
                <MenuItem Header="Zoom _Out"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateZoomOut_OnClick" />
                <MenuItem Header="_Zoom All"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateZoomAll_OnClick" />
                <Separator />
                <MenuItem Header="_Delete Selected"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateDeleteSelected_OnClick" />
                <Separator />
                <MenuItem Header="_Submit (Enter)"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateSubmit_OnClick" />
                <MenuItem Header="_Cancel (Esc)"
                          IsEnabled="{Binding IsGateDiagramVisible}"
                          Click="GateCancel_OnClick" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Unminimized"
                          ToggleType="Radio"
                          GroupName="FunctionViewMode"
                          IsChecked="{Binding IsUnminimizedViewSelected}"
                          IsEnabled="{Binding IsFunctionViewModeEnabled}"
                          Click="UnminimizedView_OnClick" />
                <MenuItem Header="_Minimized"
                          ToggleType="Radio"
                          GroupName="FunctionViewMode"
                          IsChecked="{Binding IsMinimizedViewSelected}"
                          IsEnabled="{Binding IsMinimizedViewEnabled}"
                          Click="MinimizedView_OnClick" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Help Contents"
                          Click="HelpContents_OnClick" />
                <Separator />
                <MenuItem Header="_About Logic Friday..."
                          Click="AboutLogicFriday_OnClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource LogicFriday.Brush.SurfaceContainerLow}"
                Padding="4,2">
            <StackPanel Orientation="Horizontal"
                        Spacing="2">
                <Button Classes="toolbarButton"
                        ToolTip.Tip="New..."
                        IsEnabled="{Binding IsFileNewEnabled}"
                        Click="ToolbarNew_OnClick">
                    <icons:PackIcon Kind="FilePlus" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Open..."
                        IsEnabled="{Binding IsFileOpenEnabled}"
                        Click="OpenDocument_OnClick">
                    <icons:PackIcon Kind="FolderOpen" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Save"
                        IsEnabled="{Binding IsFileSaveEnabled}"
                        Click="Save_OnClick">
                    <icons:PackIcon Kind="ContentSave" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Print"
                        IsEnabled="{Binding IsFilePrintEnabled}"
                        Click="Print_OnClick">
                    <icons:PackIcon Kind="Printer" />
                </Button>

                <Border Width="1"
                        Height="22"
                        Margin="4,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <Button x:Name="EquationEditorCutToolbarButton"
                        Classes="toolbarButton"
                        ToolTip.Tip="Cut"
                        IsEnabled="False"
                        Click="EquationEditorCut_OnClick">
                    <icons:PackIcon Kind="ContentCut" />
                </Button>
                <Button x:Name="EquationEditorCopyToolbarButton"
                        Classes="toolbarButton"
                        ToolTip.Tip="Copy"
                        IsEnabled="False"
                        Click="EquationEditorCopy_OnClick">
                    <icons:PackIcon Kind="ContentCopy" />
                </Button>
                <Button x:Name="EquationEditorPasteToolbarButton"
                        Classes="toolbarButton"
                        ToolTip.Tip="Paste"
                        IsEnabled="False"
                        Click="EquationEditorPaste_OnClick">
                    <icons:PackIcon Kind="ContentPaste" />
                </Button>
                <Button x:Name="EquationEditorUndoToolbarButton"
                        Classes="toolbarButton"
                        ToolTip.Tip="Undo"
                        IsEnabled="False"
                        Click="EquationEditorUndo_OnClick">
                    <icons:PackIcon Kind="Undo" />
                </Button>
                <Button x:Name="EquationEditorRedoToolbarButton"
                        Classes="toolbarButton"
                        ToolTip.Tip="Redo"
                        IsEnabled="False"
                        Click="EquationEditorRedo_OnClick">
                    <icons:PackIcon Kind="Redo" />
                </Button>

                <Border Width="1"
                        Height="22"
                        Margin="4,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <Button Classes="toolbarButton"
                        ToolTip.Tip="Minimize..."
                        IsEnabled="{Binding IsOperationMinimizeEnabled}"
                        Click="Minimize_OnClick">
                    <icons:PackIcon Kind="ChartBellCurve" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Map to Gates..."
                        IsEnabled="{Binding IsOperationMapToGatesEnabled}"
                        Click="MapToGates_OnClick">
                    <icons:PackIcon Kind="MapMarkerPath" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Zoom In"
                        IsEnabled="{Binding IsGateDiagramVisible}"
                        Click="GateZoomIn_OnClick">
                    <icons:PackIcon Kind="MagnifyPlus" />
                </Button>
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Zoom Out"
                        IsEnabled="{Binding IsGateDiagramVisible}"
                        Click="GateZoomOut_OnClick">
                    <icons:PackIcon Kind="MagnifyMinus" />
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource LogicFriday.Brush.SurfaceContainerLow}"
                Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Border Padding="8"
                Background="{DynamicResource LogicFriday.Brush.Surface}">
            <dock:DockControl x:Name="WorkspaceDock"
                              InitializeLayout="True"
                              InitializeFactory="True">
                <dock:DockControl.Factory>
                    <dockFactory:Factory />
                </dock:DockControl.Factory>
                <dockModel:RootDock x:Name="WorkspaceRootDock"
                                    Id="WorkspaceRoot"
                                    Title="Workspace"
                                    IsFocusableRoot="True">
                    <dockModel:ProportionalDock x:Name="WorkspaceLayoutDock"
                                                Id="WorkspaceLayout"
                                                Orientation="Vertical">
                        <dockModel:ToolDock x:Name="FunctionsToolDock"
                                            Id="FunctionsToolDock"
                                            Title="Functions"
                                            Proportion="0.24"
                                            Alignment="Top"
                                            IsCollapsable="False"
                                            CanCloseLastDockable="False">
                            <dockModel:Tool x:Name="FunctionsTool"
                                            Id="FunctionsTool"
                                            Title="Functions"
                                            CanClose="False" />
                        </dockModel:ToolDock>
                        <dockModel:ProportionalDockSplitter />
                        <dockModel:DocumentDock x:Name="WorkspaceDocumentDock"
                                                Id="WorkspaceDocumentDock"
                                                Title="Workspace"
                                                Proportion="0.76"
                                                IsCollapsable="False"
                                                CanCreateDocument="False"
                                                CanCloseLastDockable="False">
                            <dockModel:Document x:Name="TruthTableDocument"
                                                Id="TruthTableDocument"
                                                Title="Truth Table"
                                                CanClose="False" />
                            <dockModel:Document x:Name="LogicEquationDocument"
                                                Id="LogicEquationDocument"
                                                Title="Logic Equation"
                                                CanClose="False" />
                            <dockModel:Document x:Name="GateDiagramDocument"
                                                Id="GateDiagramDocument"
                                                Title="Gate Diagram"
                                                CanClose="False" />
                            <dockModel:Document x:Name="TruthTableEditorDocument"
                                                Id="TruthTableEditorDocument"
                                                Title="Truth Table Editor"
                                                CanClose="False" />
                            <dockModel:Document x:Name="EquationEditorDocument"
                                                Id="EquationEditorDocument"
                                                Title="Equation Editor"
                                                CanClose="False" />
                            <dockModel:Document x:Name="GateDiagramEditorDocument"
                                                Id="GateDiagramEditorDocument"
                                                Title="Gate Diagram Editor"
                                                CanClose="False" />
                        </dockModel:DocumentDock>
                    </dockModel:ProportionalDock>
                </dockModel:RootDock>
            </dock:DockControl>
        </Border>
    </DockPanel>

</Window>
